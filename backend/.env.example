# Backend deployment example (Render)
SECRET_KEY=replace-with-a-strong-random-secret
# development | production. Anything but development refuses to start while
# SECRET_KEY or any *_PASSWORD below is unset or a published default.
ENVIRONMENT=production
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Public demo logins (also baked into the frontend build): not secrets.
ANALYST_PASSWORD=choose-a-public-demo-password
VIEWER_PASSWORD=choose-a-public-demo-password
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# API/runtime
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_REQUEST_SIZE_BYTES=2000000
PREDICT_RATE_LIMIT_PER_MINUTE=30
# Calibrated-probability threshold; see docs/threshold_analysis.json
DECISION_THRESHOLD=0.38
# Labelled CSV (raw Telco schema) used by the promotion gate. Missing file => promotion blocked.
PROMOTION_EVAL_DATA_PATH=data/Telco-Customer-Churn.csv
DEPENDENCY_TIMEOUT_SECONDS=3.0
DEPENDENCY_RETRY_COUNT=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=15
SCHEDULE_QUALITY_CHECK_SECONDS=900
SCHEDULE_DRIFT_REPORT_SECONDS=1800

# Database
DATABASE_BACKEND=sqlite
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/churn

# Redis/cache (optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Object storage (optional)
OBJECT_STORAGE_PROVIDER=none
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_LOCAL_PATH=backend/data/objects
AZURE_BLOB_ACCOUNT_URL=
AZURE_BLOB_CREDENTIAL=
BATCH_UPLOAD_PREFIX=batch/uploads
BATCH_REPORT_PREFIX=batch/reports
