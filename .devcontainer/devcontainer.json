{
  // Python 3.13 + Node 20 + Docker CLI (talks to the host daemon for compose).
  "name": "churn-predictor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "python tasks.py setup --frontend",
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "MLFLOW_ALLOW_FILE_STORE": "true",
    "CHURN_NO_VENV": "1"
  },
  "forwardPorts": [8000, 5173, 3000, 9090],
  "portsAttributes": {
    "8000": { "label": "API" },
    "5173": { "label": "Frontend" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"]
    }
  }
}
